      "lines": [
        "Quadratische Gleichung",
        "x² - 5x + 6 = 0",
        "Mitternachtsformel (abc-Formel):",
        "x₁,₂ = (-b ± √(b² - 4ac))/2a",
        "Einsetzen mit a = 1, b = -5, c = 6:",
        "x₁,₂ = (5 ± √(25 - 24))/2 = (5 ± 1)/2",
        "• x₁ = 3",
        "• x₂ = 2",
        "Probe: 3² - 5 · 3 + 6 = 0 ✓",
        "x₁ = 3, x₂ = 2",
        "Diskriminante D = b² - 4ac: D > 0 zwei",
        "Lösungen, D = 0 eine, D < 0 keine.",
      ],
      "marks": [],
      "missing": 0,
    },
  ],
  "pages": 1,
}
`;

